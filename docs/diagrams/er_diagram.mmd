erDiagram
    USER ||--o| PHARMACY : "owns (one-to-one)"
    USER ||--o{ AVAILABILITY_REQUEST : "sends (as customer)"
    USER ||--o{ NOTIFICATION : "receives"
    PHARMACY ||--o{ INVENTORY : "lists"
    MEDICINE ||--o{ INVENTORY : "is listed in"
    PHARMACY ||--o{ AVAILABILITY_REQUEST : "receives"
    MEDICINE ||--o{ AVAILABILITY_REQUEST : "is asked about"
    AVAILABILITY_REQUEST |o--o{ NOTIFICATION : "is about"
    PHARMACY ||--o{ PHARMACY_APPROVAL_LOG : "has history"
    USER |o--o{ PHARMACY_APPROVAL_LOG : "made the change"

    USER {
        int id PK
        string username
        string email
        string role "CUSTOMER / PHARMACY / ADMIN"
        string phone_number
    }
    PHARMACY {
        int id PK
        int owner_id FK
        string pharmacy_name
        string registration_number "unique"
        string city
        string pincode
        decimal latitude
        decimal longitude
        string approval_status "PENDING / APPROVED / REVOKED"
        bool is_approved
    }
    PHARMACY_APPROVAL_LOG {
        int id PK
        int pharmacy_id FK
        int changed_by_id FK
        string from_status
        string to_status
        string reason
        datetime created_at
    }
    MEDICINE {
        int id PK
        string medicine_name
        string generic_name
        string strength
        string dosage_form
        string category
        bool is_active
    }
    INVENTORY {
        int id PK
        int pharmacy_id FK
        int medicine_id FK
        int quantity
        string availability_status "IN_STOCK / LOW_STOCK / OUT_OF_STOCK"
        datetime updated_at
    }
    AVAILABILITY_REQUEST {
        int id PK
        int customer_id FK
        int pharmacy_id FK
        int medicine_id FK
        int quantity_requested
        string status "PENDING / CONFIRMED / PARTIAL / UNAVAILABLE / CANCELLED"
        int available_quantity
        string cancel_reason
        string pharmacy_response
    }
    NOTIFICATION {
        int id PK
        int user_id FK
        int request_id FK
        string message
        bool is_read
    }

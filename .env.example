# ==============================================================================
# MediFind - LOCAL DEVELOPMENT environment (.env.example)
# Copy to .env for local use:   cp .env.example .env
# This file is safe for local use: DEBUG on, SQLite, console email.
# For production values see .env.production.example (never commit real secrets).
# ==============================================================================

# Local development only. DEBUG defaults to False when unset.
DEBUG=True

# Optional locally: when DEBUG=True and SECRET_KEY is empty, an insecure
# development key is used. Production REQUIRES a real SECRET_KEY.
SECRET_KEY=

# Defaults to localhost,127.0.0.1,[::1] when DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1

# Not needed for plain http://localhost development.
CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL unset to use the local SQLite file db.sqlite3.
# DATABASE_URL=

# Emails (password reset) are printed to the console locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MediFind <noreply@localhost>
